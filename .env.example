# Copy to .env and fill in. Never commit .env.

# Strava API app: https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to your host (localhost for local dev).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me

# Used to sign session cookies. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Public URLs. In production both are the same origin.
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Serve the demo athlete to visitors who haven't connected Strava.
DEMO_MODE=true

# Optional: live Garmin sync through the unofficial garminconnect library.
GARMIN_EMAIL=
GARMIN_PASSWORD=
